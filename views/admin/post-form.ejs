<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post ? 'Edit Post' : 'New Post' %> — Nassr Writes CMS</title>
    <link rel="stylesheet" href="/admin-cms.css">
</head>
<body class="cms-body">

<div class="cms-layout">
    <%- include('../partials/admin-sidebar', { active: 'posts', csrfToken }) %>

    <main class="cms-main">
        <div class="cms-topbar">
            <div>
                <a href="/admin/posts" class="cms-back">← Posts</a>
                <h1 class="cms-page-title"><%= post ? 'Edit Post' : 'New Post' %></h1>
            </div>
            <% if (post && post.status !== 'draft') { %>
                <a href="/blog/<%= post.slug %>" target="_blank" class="btn btn-ghost">View live ↗</a>
            <% } %>
        </div>

        <% if (error) { %>
            <div class="cms-flash cms-flash--error"><%= error %></div>
        <% } %>

        <form
            method="POST"
            action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>"
            class="cms-form"
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="cms-form-grid">
                <!-- Main column -->
                <div class="cms-form-main">
                    <div class="form-group">
                        <label for="title">Title <span class="req">*</span></label>
                        <input type="text" id="title" name="title" required maxlength="200"
                               value="<%= post ? escapeHtml(post.title) : '' %>"
                               placeholder="Post title…">
                    </div>

                    <div class="form-group">
                        <label for="excerpt">Excerpt</label>
                        <input type="text" id="excerpt" name="excerpt" maxlength="500"
                               value="<%= post ? escapeHtml(post.excerpt || '') : '' %>"
                               placeholder="One-line summary shown in the blog list">
                    </div>

                    <div class="form-group">
                        <label>Content <span class="req">*</span></label>
                        <div class="md-editor">
                            <div class="md-tabs">
                                <button type="button" class="md-tab active" data-tab="write">Write</button>
                                <button type="button" class="md-tab" data-tab="preview">Preview</button>
                                <span class="md-hint">Markdown supported</span>
                            </div>
                            <div class="md-pane" id="writePane">
                                <textarea id="content" name="content" rows="22" required
                                          placeholder="Write your post in Markdown…"><%= post ? escapeHtml(post.content || '') : '' %></textarea>
                            </div>
                            <div class="md-pane md-pane--hidden prose" id="previewPane">
                                <div id="previewContent" class="md-preview-body">
                                    <em class="cms-muted">Click "Preview" to render your Markdown.</em>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Aside -->
                <div class="cms-form-aside">
                    <div class="cms-aside-card">
                        <h3>Publish</h3>
                        <div class="form-group">
                            <label for="status">Status</label>
                            <select id="status" name="status" class="cms-select">
                                <option value="published"<%= !post || post.status !== 'draft' ? ' selected' : '' %>>Published</option>
                                <option value="draft"<%= post && post.status === 'draft' ? ' selected' : '' %>>Draft</option>
                            </select>
                            <small>Drafts are not visible on the public blog.</small>
                        </div>
                        <div class="form-group">
                            <label for="slug">Slug</label>
                            <input type="text" id="slug" name="slug" maxlength="100"
                                   value="<%= post ? escapeHtml(post.slug) : '' %>"
                                   placeholder="auto-generated">
                            <small>URL: /blog/<strong id="slugPreview"><%= post ? post.slug : '' %></strong></small>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">
                            <%= post ? 'Save changes' : 'Create post' %>
                        </button>
                    </div>

                    <% if (post) { %>
                        <div class="cms-aside-card cms-aside-card--meta">
                            <h3>Info</h3>
                            <dl class="cms-dl">
                                <dt>Created</dt>
                                <dd><%= formatDate(post.createdAt) %></dd>
                                <dt>Updated</dt>
                                <dd><%= formatDate(post.updatedAt) %></dd>
                            </dl>
                        </div>
                    <% } %>
                </div>
            </div>
        </form>
    </main>
</div>

<script>
// ── Slug auto-generation ──────────────────────────────────────────────────────
const titleInput  = document.getElementById('title');
const slugInput   = document.getElementById('slug');
const slugPreview = document.getElementById('slugPreview');
let slugManuallyEdited = !!(slugInput.value);

titleInput.addEventListener('input', () => {
    if (slugManuallyEdited) return;
    const slug = titleInput.value.toLowerCase().trim()
        .replace(/[^\w\s-]/g, '').replace(/[\s_]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 100);
    slugInput.value = slug;
    slugPreview.textContent = slug;
});
slugInput.addEventListener('input', () => {
    slugManuallyEdited = true;
    slugPreview.textContent = slugInput.value;
});

// ── Markdown preview ──────────────────────────────────────────────────────────
const writePaneEl    = document.getElementById('writePane');
const previewPaneEl  = document.getElementById('previewPane');
const previewContent = document.getElementById('previewContent');

document.querySelectorAll('.md-tab').forEach(tab => {
    tab.addEventListener('click', async () => {
        document.querySelectorAll('.md-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        if (tab.dataset.tab === 'preview') {
            writePaneEl.classList.add('md-pane--hidden');
            previewPaneEl.classList.remove('md-pane--hidden');
            previewContent.innerHTML = '<em>Rendering…</em>';
            try {
                const r = await fetch('/admin/preview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-XSRF-Token': getCsrfToken() },
                    body: JSON.stringify({ content: document.getElementById('content').value }),
                });
                const { html } = await r.json();
                previewContent.innerHTML = html || '<em class="cms-muted">Nothing to preview.</em>';
            } catch {
                previewContent.innerHTML = '<em class="cms-muted">Preview failed.</em>';
            }
        } else {
            previewPaneEl.classList.add('md-pane--hidden');
            writePaneEl.classList.remove('md-pane--hidden');
        }
    });
});

function getCsrfToken() {
    const m = document.cookie.split('; ').find(c => c.startsWith('XSRF-TOKEN='));
    return m ? decodeURIComponent(m.split('=')[1]) : '';
}
</script>
</body>
</html>
