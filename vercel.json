{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*",    "destination": "https://api.nassrwrites.com/api/:path*" },
    { "source": "/admin/:path*",  "destination": "https://api.nassrwrites.com/admin/:path*" },
    { "source": "/admin",         "destination": "https://api.nassrwrites.com/admin" },
    { "source": "/writing/:category/:slug", "destination": "/writing-detail.html" },
    { "source": "/writing/:category",       "destination": "/writing-category.html" }
  ]
}
