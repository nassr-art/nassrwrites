# Copy this file to .env and fill in real values before running locally.
# On Railway: set these as environment variables in the dashboard.

# Required in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars

# bcrypt work factor (10–12 recommended; higher = slower login but more secure)
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Node environment (set to "production" on Railway/Vercel)
NODE_ENV=development

# Port (Railway sets this automatically; leave blank locally to use 3000)
PORT=3000

# Persistent volume mount path (Railway only — leave blank for local dev)
# DATA_DIR=/app/storage
